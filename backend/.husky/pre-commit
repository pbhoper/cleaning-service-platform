#!/usr/bin/env sh

set -e

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- \
  '*.js' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.json' '*.md')

[ -z "$STAGED_FILES" ] && exit 0

echo "Formatting staged files..."
npx --no-install prettier --write -- $STAGED_FILES

LINT_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- \
  '*.js' '*.mjs' '*.cjs' '*.ts' '*.tsx')

if [ -n "$LINT_FILES" ]; then
  echo "Linting staged JavaScript and TypeScript files..."
  npx --no-install eslint --fix -- $LINT_FILES
fi

git add -- $STAGED_FILES